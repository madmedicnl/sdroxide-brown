<?xml version="1.0" encoding="utf-8"?>
<!-- Built by the release workflow:
     wix build packaging/windows/main.wxs -arch x64 \
         -d Version=<cargo version> -d BinDir=target/release -o <out>.msi

     Note: sdroxide dynamically links SoapySDR.dll; users must install
     PothosSDR (https://downloads.myriadrf.org/builds/PothosSDR/) and put it
     on PATH, which also provides the device driver modules. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <!-- SDR Oxide Brown is its own Windows product, with its OWN UpgradeCode:
         a distinct product id, install folder and registry key from upstream
         sdroxide, so the two install side by side and uninstalling one leaves
         the other alone. Sharing upstream's UpgradeCode (as an earlier build
         did) made Windows treat them as the same product — one replaced the
         other, and Add/Remove Programs could show the wrong version. -->
    <Package Name="SDR Oxide Brown"
             Manufacturer="SDR Oxide Brown"
             Version="$(var.Version)"
             UpgradeCode="372490E0-6A0F-46AB-B44B-5447BA0F3ECF"
             Language="1033"
             Compressed="yes"
             Scope="perMachine">

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <!-- Used by the Start-menu shortcut below and by the Apps & features /
             Add-Remove Programs entry. Path is relative to the repo root,
             which is where the release workflow runs `wix build`. -->
        <Icon Id="SdroxideIcon" SourceFile="packaging/windows/sdroxide-brown.ico" />
        <Property Id="ARPPRODUCTICON" Value="SdroxideIcon" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/madmedicnl/sdroxide-brown" />
        <!-- The shortcuts are authored advertised (so they may use the file as
             their KeyPath and pass ICE43); this converts them to ordinary
             non-advertised .lnk files at install, so clicking one launches the
             program instead of running an MSI self-repair check. -->
        <Property Id="DISABLEADVTSHORTCUTS" Value="1" />

        <StandardDirectory Id="ProgramFiles64Folder">
            <!-- Its own folder, not upstream's: the executable is `sdroxide.exe`
                 in both builds (shared identity), so a shared folder would have
                 one install overwrite the other's binary. -->
            <Directory Id="INSTALLFOLDER" Name="sdroxide-brown">
                <Component Id="MainExe" Guid="DE7788FB-C6E5-47E2-87D8-F24D5E6ADBE5">
                    <!-- **The shortcuts live in the executable's own component**,
                         so their KeyPath is the file they launch — a per-machine
                         file in Program Files. A *non-advertised* shortcut must
                         instead be keyed on an HKCU registry value (ICE43),
                         which in a machine-wide install leaves a per-user orphan
                         key behind; an *advertised* shortcut may use the file as
                         its KeyPath, and `DISABLEADVTSHORTCUTS` turns it into a
                         regular shortcut at install. The directories are
                         `ProgramMenuFolder`/`DesktopFolder` — the WiX directory
                         IDs, not the `CommonProgramsFolder`/`CommonDesktopFolder`
                         property names WiX 5.0.2 refuses at the link step — and
                         in this per-machine install they resolve to the all-users
                         folders. -->
                    <File Id="SdroxideExe" Source="$(var.BinDir)/sdroxide.exe" KeyPath="yes">
                        <Shortcut Id="AppShortcut"
                                  Directory="ProgramMenuFolder"
                                  Name="SDR Oxide Brown"
                                  Description="SDR transceiver and shortwave-listening tool"
                                  WorkingDirectory="INSTALLFOLDER"
                                  Advertise="yes" />
                        <Shortcut Id="DesktopAppShortcut"
                                  Directory="DesktopFolder"
                                  Name="SDR Oxide Brown"
                                  Description="SDR transceiver and shortwave-listening tool"
                                  WorkingDirectory="INSTALLFOLDER"
                                  Advertise="yes" />
                    </File>
                </Component>
                <Component Id="MinGWLibgcc" Guid="BD91C960-622D-42C3-B20D-C29F8001F83B">
                    <File Id="MinGWLibgccDll" Source="$(var.BinDir)/libgcc_s_seh-1.dll" KeyPath="yes" />
                </Component>
                <Component Id="MinGWLibstdcpp" Guid="5E9E4EE8-948E-437B-8D40-DF53EA6B9388">
                    <File Id="MinGWLibstdcppDll" Source="$(var.BinDir)/libstdc++-6.dll" KeyPath="yes" />
                </Component>
                <Component Id="MinGWLibwinpthread" Guid="92FA9E37-C984-4A7B-9EA3-5C56A5495751">
                    <File Id="MinGWLibwinpthreadDll" Source="$(var.BinDir)/libwinpthread-1.dll" KeyPath="yes" />
                </Component>
                <Component Id="LicenseFile" Guid="95058D49-1291-4D03-BDAF-26452BD61AF4">
                    <File Id="LicenseTxt" Source="LICENSE" Name="LICENSE.txt" KeyPath="yes" />
                </Component>
                <!-- sdroxide.exe embeds the RX-888's Cypress FX3 firmware
                     image, which is MIT licensed rather than GPL like the rest
                     of the binary, so its notice has to be installed too. -->
                <Component Id="Rx888FirmwareLicenseFile" Guid="A0CCC0FB-6B67-4A7D-B379-433D2DE40CE6">
                    <File Id="Rx888FirmwareLicenseTxt"
                          Source="crates/sdroxide-rx888/firmware/LICENSE.txt"
                          Name="LICENSE-rx888-firmware.txt" KeyPath="yes" />
                </Component>
                <!-- The spoken-announcement voice. CC BY-NC-SA rather than
                     GPL, which is why it is a data file the program reads at
                     run time and not something linked into sdroxide.exe: its
                     notice ships beside it. sdroxide looks for voices in a
                     "voices" directory next to the executable, which is what
                     this installs. -->
                <Component Id="VoiceLicenseFile" Guid="96C8C6A9-5EF6-4E46-BFAB-BF3A9FEEDD0E">
                    <File Id="VoiceLicenseTxt"
                          Source="assets/voices/LICENSE-voice.txt"
                          Name="LICENSE-voice.txt" KeyPath="yes" />
                </Component>
                <!-- sdroxide.exe embeds CMUdict for grapheme-to-phoneme.
                     BSD-2-Clause, so the notice travels with the binary for
                     the same reason the RX-888 firmware's does. -->
                <Component Id="CmudictLicenseFile" Guid="A6093759-F5C0-4194-9B86-1A43D831D0A5">
                    <File Id="CmudictLicenseTxt"
                          Source="crates/sdroxide-speech/assets/LICENSE-cmudict.txt"
                          Name="LICENSE-cmudict.txt" KeyPath="yes" />
                </Component>
                <Directory Id="VoicesFolder" Name="voices">
                    <Component Id="VoiceModel" Guid="BEA70FBA-4EA8-46F1-8AC5-816F96AF6C63">
                        <File Id="VoiceOnnx"
                              Source="assets/voices/en_US-hfc_female-medium.onnx"
                              KeyPath="yes" />
                        <File Id="VoiceOnnxJson"
                              Source="assets/voices/en_US-hfc_female-medium.onnx.json" />
                        <File Id="VoiceModelCard"
                              Source="assets/voices/en_US-hfc_female-medium.MODEL_CARD" />
                    </Component>
                </Directory>
                <Component Id="PathEnv" Guid="CAAE2010-45B2-44C9-9B24-334CA0C34583">
                    <RegistryValue Root="HKLM" Key="Software\sdroxide-brown" Name="PathEnv" Type="integer" Value="1" KeyPath="yes" />
                    <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
                </Component>
            </Directory>
        </StandardDirectory>

        <Feature Id="Main">
            <ComponentRef Id="MainExe" />
            <ComponentRef Id="MinGWLibgcc" />
            <ComponentRef Id="MinGWLibstdcpp" />
            <ComponentRef Id="MinGWLibwinpthread" />
            <ComponentRef Id="LicenseFile" />
            <ComponentRef Id="Rx888FirmwareLicenseFile" />
            <ComponentRef Id="VoiceLicenseFile" />
            <ComponentRef Id="CmudictLicenseFile" />
            <ComponentRef Id="VoiceModel" />
            <ComponentRef Id="PathEnv" />
        </Feature>
    </Package>
</Wix>
